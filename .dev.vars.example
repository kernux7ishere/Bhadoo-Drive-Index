# Copy this file to .dev.vars for local development (wrangler dev).
# .dev.vars is already in .gitignore — never commit real credentials.

# ── Secrets ───────────────────────────────────────────────────────────────────
# Multi-account (recommended). Generate with:
#   npm run rclone:import -- --dev-vars .dev.vars
# Each ROOTS entry picks an account by its "account" name.
# ACCOUNTS_JSON=[{"name":"work","client_id":"...","client_secret":"...","refresh_token":"..."},{"name":"sa1","service_account_json":{"client_email":"...","private_key":"..."}}]
# ROOTS=[{"id":"root","type":"root","name":"Work","account":"work"},{"id":"0AAA...","type":"shared_drive","name":"Team","account":"sa1"}]

# Single account: used by every root that has no "account".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

# Generate your own: openssl rand -hex 16  /  openssl rand -hex 32
CRYPTO_BASE_KEY=change-me-change-me-change-me-12
HMAC_BASE_KEY=generate-with-openssl-rand-hex-32-at-least-32-chars

# Only needed when USE_SERVICE_ACCOUNT=true (one account object or an array)
# SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Only needed when ENABLE_LOGIN=true and LOGIN_DATABASE=Local
# USERS_JSON=[{"username":"admin","password":"change-me"}]

# ── Plain vars (override wrangler.toml for local dev) ─────────────────────────
ENVIRONMENT=development
