# Copy this file to .dev.vars for local development (wrangler dev).
# .dev.vars is already in .gitignore — never commit real credentials.

# ── Secrets ───────────────────────────────────────────────────────────────────
# Generate keys with: openssl rand -hex 16  /  openssl rand -hex 32
CRYPTO_BASE_KEY=change-me-change-me-change-me-12
HMAC_BASE_KEY=generate-with-openssl-rand-hex-32-at-least-32-chars

# Google Accounts: JSON array (can be imported with `npm run rclone:import -- --dev-vars .dev.vars`)
ACCOUNTS_JSON=[{"name":"default","client_id":"your-id","client_secret":"your-secret","refresh_token":"your-token"}]

# Index Scope: JSON array of drives/buckets
SCOPE=[{"id":"root","type":"root","name":"My Drive","account":"default","protect_file_link":false}]

# Only needed when ENABLE_LOGIN=true and LOGIN_DATABASE=Local
# USERS_JSON=[{"username":"admin","password":"change-me"}]

# ── Plain vars (override wrangler.toml for local dev) ─────────────────────────
ENVIRONMENT=development
