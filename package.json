{
  "name": "bhadoo-drive-index",
  "version": "2.0.18",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "rclone:import": "python3 scripts/rclone-to-accounts.py",
    "secret:accounts": "wrangler secret put ACCOUNTS_JSON",
    "secret:crypto-key": "wrangler secret put CRYPTO_BASE_KEY",
    "secret:hmac-key": "wrangler secret put HMAC_BASE_KEY"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
